{
  "rewrites": [
    { "source": "/admin",            "destination": "/admin.html" },
    { "source": "/scorecard",        "destination": "/scorecard.html" },
    { "source": "/growth-leak-audit","destination": "/growth-leak-audit.html" },
    { "source": "/thank-you",        "destination": "/thank-you.html" },
    { "source": "/blog",             "destination": "/blog.html" },
    { "source": "/blog/:slug",       "destination": "/api/blog-render?slug=:slug" },
    { "source": "/portfolio",        "destination": "/portfolio.html" },
    { "source": "/portfolio/:slug",  "destination": "/api/portfolio-render?slug=:slug" }
  ]
}
